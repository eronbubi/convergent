# Supabase project (Project Settings → API Keys). Leave empty to run with demo content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Lets the site count prompt copies from visitors who aren't logged in.
SUPABASE_SECRET_KEY=

# Public address of the site, used in email links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
